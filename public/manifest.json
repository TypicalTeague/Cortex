{
  "manifest_version": 3,
  "name": "Cortex: Thinking Companion for ChatGPT",
  "short_name": "Cortex",
  "version": "1.0.0",
  "description": "Keeps your own thinking at the center when you use ChatGPT. Quick questions pass through; real tasks start from your ideas.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cortex",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
